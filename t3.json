{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/cody/icon-180.png",
  "scripts": [
    {
      "name": "Preview This Checkout",
      "command": "node scripts/cody-preview.mjs dev",
      "icon": "configure"
    },
    {
      "name": "Refresh Preview Threads",
      "command": "node scripts/cody-preview.mjs snapshot",
      "icon": "configure"
    },
    {
      "name": "Build & Open Cody Preview",
      "command": "node scripts/cody-preview.mjs native",
      "icon": "configure"
    },
    {
      "name": "Sync Cody",
      "command": "node scripts/cody.mjs sync",
      "icon": "configure"
    },
    {
      "name": "Start Cody Dev",
      "command": "node scripts/cody.mjs dev",
      "icon": "configure"
    },
    {
      "name": "Build Cody Release",
      "command": "node scripts/cody.mjs release",
      "icon": "configure"
    },
    {
      "name": "Setup Worktree",
      "command": "node scripts/setup-worktree.ts",
      "icon": "configure",
      "runOnWorktreeCreate": true
    }
  ]
}
